 "rule_groups": [
  {
   "key": "stack",
   "title": "The stack",
   "sub": "QB + catchers, from the right game"
  },
  {
   "key": "oneoffs",
   "title": "Bring-back & one-offs",
   "sub": "correlate the rest, never double up"
  },
  {
   "key": "chalk",
   "title": "Chalk & leverage",
   "sub": "own the right chalk, never two busts"
  },
  {
   "key": "build",
   "title": "Salary, DST, FLEX",
   "sub": "spend it all, cheap DST, RB flex"
  },
  {
   "key": "portfolio",
   "title": "Portfolio",
   "sub": "per batch, for 2+ entries"
  }
 ],
 "rule_cards": [
  {
   "group": "stack",
   "path": "hard.qb_min_same_team_catchers",
   "fmt": "int",
   "title": "Never a naked QB",
   "rule": "QB + at least {v} same-team pass-catcher (WR or TE)",
   "why": "The pass-catcher is the correlation. The naked QB under-indexes from field to top 1% in the cohort study.",
   "stat": "winners.catchers.naked",
   "stat_label": "winners were naked anyway",
   "cohort": "stack_shape"
  },
  {
   "group": "stack",
   "path": "soft.qb_catchers_default",
   "fmt": "int",
   "title": "Default to QB + 2",
   "rule": "QB + {v} pass-catchers is the default build; QB + 3 (2 WR + TE) in ≥48 totals",
   "why": "The second (and third) catcher is the correlation the field skips — QB + 2 WR + TE is the biggest field-to-top-3 ratio in the cohort table.",
   "cohort": "stack_shape"
  },
  {
   "group": "stack",
   "path": "soft.qb_game_total_min",
   "fmt": "num",
   "title": "Stack a real game",
   "rule": "QB game total ≥ {v}",
   "why": "Winning QB games come from high totals and almost never from grind totals. The winning QB game is not always the slate's highest total — but it is rarely a low one.",
   "stat": "winner_games.rows.total_ge48",
   "stat_label": "winning QB games had a 48+ total"
  },
  {
   "group": "stack",
   "path": "soft.qb_team_dog_max",
   "fmt": "num",
   "title": "Favorite or a small dog",
   "rule": "QB's team no bigger than a +{v} dog",
   "why": "Winning QBs are usually favored; a big dog almost never produces the winning stack. The bring-back rate is the same either way — the bring-back is about the game going over.",
   "stat": "winner_games.rows.team_dog7",
   "stat_label": "winning QBs were 7+ dogs"
  },
  {
   "group": "stack",
   "path": "soft.qb_salary_max",
   "fmt": "money",
   "title": "The QB is cheap",
   "rule": "QB salary ≤ {v}",
   "why": "The field pays up for the name QB. Winners pay for a 30-point path at $5.5–6.5k and let the savings buy the RB1.",
   "stat": "winners.qb.salary_le_max",
   "stat_label": "winning QBs at or under the cap"
  },
  {
   "group": "stack",
   "path": "soft.qb_own_max",
   "fmt": "pct_raw",
   "title": "…and low-owned",
   "rule": "QB ownership ≤ {v}",
   "why": "The QB is the correlation engine, not the star — a low-owned one is where the lineup gets unique.",
   "stat": "winners.qb.own_le_max",
   "stat_label": "winning QBs at or under the cap"
  },
  {
   "group": "oneoffs",
   "path": "soft.bring_back_lean",
   "fmt": "text",
   "title": "Bring it back, lean {v}",
   "rule": "One bring-back from the QB's opponent, preferably the {v}",
   "why": "The field brings back the WR. The opposing RB — who scores when your QB's team is throwing to catch up, or salts it away — is the under-built version.",
   "stat": "winners.bring_back.any",
   "stat_label": "winners had any bring-back",
   "cohort": "bring_back"
  },
  {
   "group": "oneoffs",
   "path": "soft.secondary_opposing_pair_required",
   "fmt": "bool",
   "title": "Build a second game",
   "rule": "At least one opposing pair from a game your QB isn't in",
   "why": "The field concentrates correlation in the QB game and scatters the rest. Winners build a second, opposing mini-stack — RB vs WR is the best version.",
   "stat": "winners.secondary.opp_pair_any",
   "stat_label": "winners had a secondary opposing pair",
   "cohort": "secondary"
  },
  {
   "group": "oneoffs",
   "path": "hard.max_secondary_same_team_pairs",
   "fmt": "int",
   "title": "One-offs never double up",
   "rule": "At most {v} teammate pairs outside the QB game",
   "why": "Two players from a non-QB team split one offense's points. Outside the QB game, correlate opposing players or play singles.",
   "stat": "winners.secondary.same_team_pair_any",
   "stat_label": "winners had one anyway",
   "cohort": "secondary"
  },
  {
   "group": "oneoffs",
   "path": "soft.games_represented",
   "fmt": "range",
   "title": "Cluster into 4–6 games",
   "rule": "{v} games represented",
   "why": "Winners cluster into fewer games than the field; 7+ games represented under-indexes.",
   "stat": "winner_checks.soft.games_represented",
   "stat_label": "winners in the band",
   "cohort": "games"
  },
  {
   "group": "oneoffs",
   "path": "hard.max_players_one_team",
   "fmt": "int",
   "title": "Max from one team",
   "rule": "No more than {v} players from one team",
   "why": "Three from one team is a stack; four is a bet on one offense doing everything.",
   "stat": "winner_checks.hard.max_players_one_team",
   "stat_label": "winners within the cap"
  },
  {
   "group": "oneoffs",
   "path": "hard.max_players_one_game",
   "fmt": "int",
   "title": "Max from one game",
   "rule": "No more than {v} players from one game",
   "why": "Game stacks past five players are rare in winners and heavily duplicated in the field.",
   "stat": "winner_checks.hard.max_players_one_game",
   "stat_label": "winners within the cap"
  },
  {
   "group": "chalk",
   "path": "hard.max_negative_leverage_chalk_per_lineup",
   "fmt": "int",
   "title": "Never two chalk busts",
   "rule": "At most {v} negative-leverage chalk piece (owned ≥ {chalk}% with Optimal % below ownership)",
   "why": "\"Fade chalk\" is wrong — winners carry one or two chalk pieces. The rule is never two the sim rates negative-leverage: either bust kills the lineup.",
   "stat": "winners.ownership.has_ge30",
   "stat_label": "winners carried a 30%+ player",
   "needs": "ownership + Optimal % (a Stokastic Data Hub file)"
  },
  {
   "group": "chalk",
   "path": "soft.sub5_ceiling_plays",
   "fmt": "range",
   "title": "1–2 sub-5% ceiling plays",
   "rule": "{v} players under 5% owned — chosen by Optimal %, not salary",
   "why": "The low-owned pieces make the lineup yours — but each needs a 20-point path (Optimal % above ownership), not salary relief.",
   "stat": "winner_checks.soft.sub5_ceiling_plays",
   "stat_label": "winners had 1–2",
   "needs": "ownership"
  },
  {
   "group": "chalk",
   "path": "portfolio.exposure_max_chalk",
   "fmt": "share",
   "title": "Cap chalk exposure",
   "rule": "≤ {v} of the batch on any negative-leverage chalk player",
   "why": "One chalk bust shouldn't sink half the batch. (Ethan, W1 2026: four players at 44–61% exposure put two busts in 14 of 18 lineups.)"
  },
  {
   "group": "chalk",
   "path": "portfolio.exposure_max_non_qb",
   "fmt": "share",
   "title": "Cap everyone else",
   "rule": "≤ {v} of the batch on any non-QB player",
   "why": "Exposure caps and contest selection are worth more than any single build rule."
  },
  {
   "group": "build",
   "path": "hard.min_salary_used",
   "fmt": "money",
   "title": "Spend the cap",
   "rule": "Salary used ≥ {v}",
   "why": "Opposite of showdown: winners spend the whole cap. Uniqueness comes from the stack shape, not salary left.",
   "stat": "winners.salary.full_cap",
   "stat_label": "winners used the full cap"
  },
  {
   "group": "build",
   "path": "hard.offense_vs_own_dst_max",
   "fmt": "int",
   "title": "No offense vs your DST",
   "rule": "{v} players facing your own DST",
   "why": "Your DST scores when that offense doesn't. Rostering both is a hedge, not a stack.",
   "stat": "winners.dst.offense_vs_own_dst",
   "stat_label": "winners did it anyway",
   "cohort": "dst"
  },
  {
   "group": "build",
   "path": "soft.dst_salary_max",
   "fmt": "money",
   "title": "Cheap DST vs a bad QB",
   "rule": "DST salary ≤ {v}",
   "why": "Cheap DST against a replacement, backup or rookie QB — never the $4k+ name DST.",
   "stat": "winners.dst.vs_non_franchise_qb",
   "stat_label": "winning DSTs faced a non-franchise QB"
  },
  {
   "group": "build",
   "path": "soft.flex_default",
   "fmt": "text",
   "title": "FLEX = {v}",
   "rule": "Default the FLEX to a {v}; TE-FLEX when the cheap TE is a stack or bring-back piece",
   "why": "The FLEX position is regime-dependent, but RB has led in the winners and WR-FLEX is the field's habit.",
   "stat": "winners.flex.RB",
   "stat_label": "winning FLEX was an RB"
  },
  {
   "group": "portfolio",
   "path": "portfolio.distinct_qbs_min_for_4plus",
   "fmt": "int",
   "title": "Spread the QBs",
   "rule": "At least {v} distinct QBs in a batch of 4+",
   "why": "A portfolio is not one bet made N times."
  },
  {
   "group": "portfolio",
   "path": "portfolio.single_stack_share_max",
   "fmt": "share",
   "title": "No stack over 40%",
   "rule": "No single QB stack in more than {v} of the batch",
   "why": "A batch should hold more than one game story."
  },
