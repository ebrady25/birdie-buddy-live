 "ten_laws": [
  {
   "n": 1,
   "law": "Leverage lives at captain. Chalk lives in the flex.",
   "evidence": "Winners' CPT own median 9.5% (54% under 10%); the same winners carry ~1.5 players >=50% owned and cum own ~204%."
  },
  {
   "n": 2,
   "law": "Captain the player who can be the game's highest scorer, not the best value.",
   "evidence": "Winning CPT median salary $13,500 (1.5x); cheap captains that won scored 2.6x projection."
  },
  {
   "n": 3,
   "law": "WR and RB win the seat more than the field's QB habit.",
   "evidence": "CPT position of winners WR 39 / RB 22 / QB 20 / TE 15 / DST 4 / K 1; field captains QBs 30-35%."
  },
  {
   "n": 4,
   "law": "Favorite side by default; big favorite = the cleanest rule in the sport.",
   "evidence": "Nut CPT from favorite: spread <=3 66%, 3.5-7 58%, >7 80% (RB 44% of those)."
  },
  {
   "n": 5,
   "law": "The dog pocket-QB captain is a graveyard.",
   "evidence": "Dog QB at +3.5 or more = nut CPT 3 of 205 games (1.5%)."
  },
  {
   "n": 6,
   "law": "Almost no punts. Winners are not unique because of a $200 guy.",
   "evidence": "Sub-5%-owned players per winning lineup: 0.18."
  },
  {
   "n": 7,
   "law": "Kickers are in ~half of winning lineups. Never two. Never at captain.",
   "evidence": "K in lineup 41% overall, 49% in 2025; double-K 1.1% of top-1%; K captain 1%."
  },
  {
   "n": 8,
   "law": "Shape follows the spread: 4-2 modal, 5-1 the blowout weapon, 3-3 the field's comfort zone.",
   "evidence": "Winners 4-2 47% / 3-3 36% / 5-1 17%; spread >7 top-0.1% was 5-1 89-98%."
  },
  {
   "n": 9,
   "law": "Both QBs is a shape, not a leak - in ~1/3 of the batch.",
   "evidence": "Both QBs in 34% of winners; 84% in the W2 DET@BUF 72-point shootout, 2-3% in W1 blowouts."
  },
  {
   "n": 10,
   "law": "Dupes are the silent rake.",
   "evidence": "DEN@KC winner shared 1st 102 ways; product of ownership predicts dupes (r^2 0.43)."
  }
